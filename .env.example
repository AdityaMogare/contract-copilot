# Copy to .env (gitignored). None of these are secrets: auth is Entra tokens via DefaultAzureCredential.
AZURE_OPENAI_ENDPOINT=https://ais-cczq9h.cognitiveservices.azure.com/
AZURE_OPENAI_API_VERSION=2025-04-01-preview
CHAT_DEPLOYMENT=chat
EMBED_DEPLOYMENT=embed
SEARCH_ENDPOINT=https://srch-cczq9h.search.windows.net
KEY_VAULT_URL=https://kv-cczq9h.vault.azure.net/
STORAGE_ACCOUNT_URL=https://stcczq9h.blob.core.windows.net
STORAGE_CONTAINER=far-raw
SMOKE_TIMEOUT_S=20
# AZURE_CLIENT_ID is set only in Azure (clientId of id-app-cczq9h); leave unset locally.
# Entra token validation (design 02). Locally off; in Azure AUTH_REQUIRED=true with these set.
AUTH_REQUIRED=false
# AUTH_TENANT_ID=9ddaaca1-389f-4cb1-a113-081be6cc25fc
# AUTH_AUDIENCE=<appId of contract-copilot-web>

# App Insights (design 04). Not a secret once local auth is off (infra step 2b):
# APPLICATIONINSIGHTS_CONNECTION_STRING=<az monitor app-insights component show ... --query connectionString>
